# Copy to .env.local and fill in.
# .env.local is gitignored — never commit secrets.

ANTHROPIC_API_KEY=sk-ant-...

# Basic-auth gate for the deployed app.
# Required on production deployments (any env where VERCEL=1).
# If either is missing on a deployed instance the app returns 503 — fail-closed.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Supabase persistence (saved accounts + chat history).
# Optional — if unset, the app runs in local-only mode and the Saved Accounts
# section shows a warning. Use the SERVICE ROLE key (server-only) here, never
# the anon key. The service role bypasses RLS, which is fine because all DB
# access is through API routes that are gated by basic-auth above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
